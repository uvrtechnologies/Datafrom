PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# MongoDB Atlas or another production MongoDB deployment
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=generate-a-unique-secret-at-least-32-characters-long
JWT_EXPIRES_IN=8h

# Comma-separated deployed frontend origins, with no localhost values
CLIENT_ORIGIN=https://public.example.com,https://admin.example.com

# Used only by npm run seed:admin, then remove the password
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_ADMIN_MOBILE=9876543210
